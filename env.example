HEADLESS=false
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20
DOWNLOAD_DIR=./downloads
DEBUG_DIR=./debug

# Credenciales portal Subcontrataley
# Si la clave tiene # " ' o espacios, usa comillas dobles:
# SUBCONTRATALEY_PASSWORD="tu_clave_con_#"
SUBCONTRATALEY_USERNAME=
SUBCONTRATALEY_PASSWORD=

# Google Cloud Storage (liquidaciones / asistencias / cotizaciones)
GCS_BUCKET_NAME=worldwide-documentos-instalaciones
# Local: path al JSON de la SA. En Cloud Run: dejar vacío (ADC de la SA del Job).
GCS_CREDENTIALS_PATH=

# ControlRoll — contratos firmados (reporte ServiceUrl method=report)
# TOKEN_CR_CONTRATOS=

# Chrome en contenedor (Dockerfile ya exporta estos)
# CHROME_BIN=/usr/bin/google-chrome
# CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# --- Cloud Run Jobs (igual que documentos-instalaciones) ---
# Una imagen → N jobs (*_cloudrun.py)
#   gcloud builds submit --config=cloudbuild.yaml .
#   bash deploy_jobs.sh
# Secrets una vez (no los pisa el update de vars base):
#   gcloud run jobs update subcontrataley-ingreso-trabajadores --region=us-east1 \
#     --update-env-vars="SUBCONTRATALEY_USERNAME=...,SUBCONTRATALEY_PASSWORD=...,TOKEN_CR_CONTRATOS=..."
#   gcloud run jobs execute subcontrataley-ingreso-trabajadores --region=us-east1
# INGRESO_CARGA_TIMEOUT=600

# Recorre todo el flujo sin disparar la carga final al portal (pruebas)
DRY_RUN=false
